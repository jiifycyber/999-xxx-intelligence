import 'dart:async';
import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

import '../core/genesis_theme.dart';

class LiveEndpointFleet extends StatefulWidget {
  const LiveEndpointFleet({super.key});

  @override
  State<LiveEndpointFleet> createState() => _LiveEndpointFleetState();
}

class _LiveEndpointFleetState extends State<LiveEndpointFleet> {
  Map<String, dynamic>? data;
  String? error;
  Timer? timer;

  @override
  void initState() {
    super.initState();
    refresh();
    timer = Timer.periodic(const Duration(seconds: 5), (_) => refresh());
  }

  Future<void> refresh() async {
    try {
      final response = await http
          .get(Uri.parse(
              'https://jontariuss-macbook-pro.tail49e2f2.ts.net:8788/telemetry'))
          .timeout(const Duration(seconds: 4));
      if (response.statusCode != 200)
        throw Exception('HTTP ${response.statusCode}');
      final next = jsonDecode(response.body) as Map<String, dynamic>;
      if (!mounted) return;
      setState(() {
        data = next;
        error = null;
      });
    } catch (exception) {
      if (!mounted) return;
      setState(() => error = exception.toString());
    }
  }

  @override
  void dispose() {
    timer?.cancel();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(builder: (context, box) {
      final compact = box.maxHeight < 260 || box.maxWidth < 620;
      return Container(
        padding: EdgeInsets.all(compact ? 8 : 13),
        decoration: BoxDecoration(
          gradient: const LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: [
              Color(0xFF103A78),
              Color(0xFF082A59),
              Color(0xFF071B3B),
              Color(0xFF111637),
              Color(0xFF211047),
            ],
            stops: [0, .24, .50, .74, 1],
          ),
          borderRadius: BorderRadius.circular(18),
          border: Border.all(
            color: GenesisColors.cyan.withValues(alpha: .92),
            width: 1.15,
          ),
          boxShadow: [
            BoxShadow(
              color: GenesisColors.cyan.withValues(alpha: .30),
              blurRadius: 22,
              spreadRadius: .4,
            ),
            BoxShadow(
              color: GenesisColors.purple.withValues(alpha: .20),
              blurRadius: 34,
              spreadRadius: .5,
            ),
            const BoxShadow(
              color: Color(0x77000000),
              blurRadius: 24,
              offset: Offset(0, 12),
            ),
          ],
        ),
        child: Column(children: [
          Row(children: [
            const Icon(Icons.dns_rounded, color: GenesisColors.cyan, size: 19),
            const SizedBox(width: 7),
            const Expanded(
              child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('ENDPOINT FLEET',
                        style: TextStyle(
                            color: GenesisColors.text,
                            fontSize: 11,
                            fontWeight: FontWeight.w900)),
                    Text('LIVE AUTHORIZED TELEMETRY - 5 SEC REFRESH',
                        style:
                            TextStyle(color: GenesisColors.muted, fontSize: 6)),
                  ]),
            ),
            _StatusPill(
                label: data != null ? 'LIVE' : 'CONNECTING',
                online: data != null),
          ]),
          const SizedBox(height: 8),
          if (data == null)
            Expanded(
              child: Center(
                child: Text(
                  error == null
                      ? 'ESTABLISHING SECURE LINK...'
                      : 'AGENT OFFLINE\n$error',
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                      color: GenesisColors.warning,
                      fontSize: 8,
                      fontWeight: FontWeight.w800),
                ),
              ),
            )
          else
            Expanded(child: compact ? _compact() : _detailed()),
        ]),
      );
    });
  }

  Widget _compact() {
    final mac = data!['mac'] as Map<String, dynamic>;
    final iphone = data!['iphone'] as Map<String, dynamic>;

    return Column(
      children: [
        Expanded(
          child: _CompactDevice(
            icon: Icons.laptop_mac_rounded,
            name: 'MACBOOK PRO',
            address: '${mac['address']}',
            online: mac['online'] == true,
            detail: 'CPU ${mac['cpuPercent']}%  MEM ${mac['memoryPercent']}%',
          ),
        ),
        const SizedBox(height: 12),
        Expanded(
          child: _CompactDevice(
            icon: Icons.phone_iphone_rounded,
            name: 'IPHONE',
            address: '${iphone['address']}',
            online: iphone['online'] == true,
            detail: iphone['latencyMs'] == null
                ? 'NO RESPONSE'
                : '${iphone['latencyMs']} MS',
          ),
        ),
      ],
    );
  }

  Widget _detailed() {
    final mac = data!['mac'] as Map<String, dynamic>;
    final iphone = data!['iphone'] as Map<String, dynamic>;
    return Row(children: [
      Expanded(
          child: _DeviceCard(
        icon: Icons.laptop_mac_rounded,
        name: 'MACBOOK PRO',
        type: 'PRIMARY COCKPIT',
        address: '${mac['address']}',
        online: mac['online'] == true,
        readings: {
          'CPU LOAD': '${mac['cpuPercent']}%',
          'MEMORY': '${mac['memoryPercent']}%',
          'STORAGE': '${mac['diskPercent']}%',
          'FIREWALL': '${mac['firewall']}',
          'TAILSCALE': mac['tailscale'] == true ? 'CONNECTED' : 'OFFLINE',
          'UPTIME': _uptime(mac['uptimeSeconds'] as num?),
        },
      )),
      const SizedBox(width: 12),
      Expanded(
          child: _DeviceCard(
        icon: Icons.phone_iphone_rounded,
        name: 'IPHONE',
        type: 'MOBILE COMMAND',
        address: '${iphone['address']}',
        online: iphone['online'] == true,
        readings: {
          'TAILSCALE LINK': iphone['online'] == true ? 'CONNECTED' : 'OFFLINE',
          'LATENCY': iphone['latencyMs'] == null
              ? 'NO RESPONSE'
              : '${iphone['latencyMs']} MS',
          'MONITORING': 'NETWORK PRESENCE',
          'AUTHORIZATION': 'OWNER DEVICE',
        },
      )),
    ]);
  }

  String _uptime(num? seconds) {
    if (seconds == null) return 'N/A';
    final hours = seconds.toInt() ~/ 3600;
    return '${hours ~/ 24}D ${hours % 24}H';
  }
}

class _CompactDevice extends StatelessWidget {
  const _CompactDevice(
      {required this.icon,
      required this.name,
      required this.address,
      required this.online,
      required this.detail});
  final IconData icon;
  final String name;
  final String address;
  final bool online;
  final String detail;

  @override
  Widget build(BuildContext context) {
    final color = online ? GenesisColors.emerald : GenesisColors.danger;
    return Container(
        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
        decoration: BoxDecoration(
            color: color.withValues(alpha: .06),
            borderRadius: BorderRadius.circular(7),
            border: Border.all(color: color.withValues(alpha: .45))),
        child: Row(children: [
          Icon(icon, color: color, size: 18),
          const SizedBox(width: 7),
          Expanded(
              child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                Text(name,
                    style: const TextStyle(
                        color: GenesisColors.text,
                        fontSize: 8,
                        fontWeight: FontWeight.w900)),
                Text('$address - $detail',
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(
                        color: GenesisColors.muted, fontSize: 6)),
              ])),
          _StatusPill(label: online ? 'ONLINE' : 'OFFLINE', online: online),
        ]));
  }
}

class _DeviceCard extends StatelessWidget {
  const _DeviceCard(
      {required this.icon,
      required this.name,
      required this.type,
      required this.address,
      required this.online,
      required this.readings});
  final IconData icon;
  final String name;
  final String type;
  final String address;
  final bool online;
  final Map<String, String> readings;

  @override
  Widget build(BuildContext context) {
    final color = online ? GenesisColors.emerald : GenesisColors.danger;
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
          color: const Color(0xFF091B38),
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: color.withValues(alpha: .65))),
      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Icon(icon, color: color, size: 34),
          const SizedBox(width: 10),
          Expanded(
              child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                Text(name,
                    style: const TextStyle(
                        color: GenesisColors.text,
                        fontSize: 15,
                        fontWeight: FontWeight.w900)),
                Text(type,
                    style: const TextStyle(
                        color: GenesisColors.muted, fontSize: 8)),
              ])),
          _StatusPill(label: online ? 'ONLINE' : 'OFFLINE', online: online),
        ]),
        const SizedBox(height: 13),
        _reading('ADDRESS', address),
        for (final entry in readings.entries) _reading(entry.key, entry.value),
      ]),
    );
  }

  Widget _reading(String label, String value) => Padding(
        padding: const EdgeInsets.only(bottom: 7),
        child: Row(children: [
          Text(label,
              style: const TextStyle(color: GenesisColors.muted, fontSize: 8)),
          const Spacer(),
          Text(value,
              style: const TextStyle(
                  color: GenesisColors.cyan,
                  fontSize: 9,
                  fontWeight: FontWeight.w800)),
        ]),
      );
}

class _StatusPill extends StatelessWidget {
  const _StatusPill({required this.label, required this.online});
  final String label;
  final bool online;

  @override
  Widget build(BuildContext context) {
    final color = online ? GenesisColors.emerald : GenesisColors.warning;
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 4),
      decoration: BoxDecoration(
          color: color.withValues(alpha: .12),
          borderRadius: BorderRadius.circular(20),
          border: Border.all(color: color)),
      child: Text(label,
          style: TextStyle(
              color: color, fontSize: 6, fontWeight: FontWeight.w900)),
    );
  }
}
