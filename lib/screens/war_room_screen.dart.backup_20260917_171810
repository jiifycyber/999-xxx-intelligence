class WarRoomScreen extends StatefulWidget {
  const WarRoomScreen({super.key});

  @override
  State<WarRoomScreen> createState() => _WarRoomScreenState();
}

class _WarRoomScreenState extends State<WarRoomScreen>
    with SingleTickerProviderStateMixin {
  late final AnimationController _pulse;
  int _selected = 0;

  @override
  void initState() {
    super.initState();
    _pulse = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 4),
    )..repeat();
  }

  @override
  void dispose() {
    _pulse.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: GenesisColors.voidBlack,
      body: LayoutBuilder(
        builder: (context, viewport) {
          // Closer, more readable Genesis command-center viewport.
          // The former 1840 x 1035 canvas made the entire interface appear distant.
          final canvasWidth = math.max(1480.0, viewport.maxWidth);
          final canvasHeight = math.max(832.0, viewport.maxHeight);

          return SizedBox.expand(
            child: ColoredBox(
              color: GenesisColors.voidBlack,
              child: FittedBox(
                fit: BoxFit.scaleDown,
                alignment: Alignment.center,
                child: SizedBox(
                  width: canvasWidth,
                  height: canvasHeight,
                  child: Column(
                    children: [
                      const _CommandHeader(),
                      Expanded(
                        child: Row(
                          children: [
                            _NavigationRail(
                              selected: _selected,
                              onSelected: (value) =>
                                  setState(() => _selected = value),
                            ),
                            Expanded(
                              child: _selected == 0
                                  ? _CommandCenter(pulse: _pulse)
                                  : _SectionScreen(
                                      index: _selected, pulse: _pulse),
                            ),
                          ],
                        ),
                      ),
                      const _OperationConsole(),
                    ],
                  ),
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}

