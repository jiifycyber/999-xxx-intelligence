class _DukeCorePainter extends CustomPainter {
  const _DukeCorePainter();

  @override
  void paint(Canvas canvas, Size size) {
    final center = size.center(Offset.zero);
    final radius = math.min(size.width, size.height) / 2;

    canvas.drawCircle(
      center,
      radius - 2,
      Paint()
        ..shader = const RadialGradient(
          colors: [
            Color(0x5527C8F7),
            Color(0x22103F54),
            Color(0xFF030A11),
          ],
          stops: [0, .55, 1],
        ).createShader(Offset.zero & size),
    );

    for (final ring in [radius - 3, radius - 10, radius - 18]) {
      canvas.drawCircle(
        center,
        ring,
        Paint()
          ..color = GenesisColors.cyan.withValues(alpha: .55)
          ..style = PaintingStyle.stroke
          ..strokeWidth = ring == radius - 3 ? 1.6 : .65,
      );
    }

    final tickPaint = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .75)
      ..strokeWidth = 1;

    for (var i = 0; i < 24; i++) {
      final angle = i * math.pi * 2 / 24;
      final outer = Offset(
        center.dx + math.cos(angle) * (radius - 5),
        center.dy + math.sin(angle) * (radius - 5),
      );
      final innerRadius = i.isEven ? radius - 11 : radius - 8;
      final inner = Offset(
        center.dx + math.cos(angle) * innerRadius,
        center.dy + math.sin(angle) * innerRadius,
      );
      canvas.drawLine(inner, outer, tickPaint);
    }

    final orbitPaint = Paint()
      ..color = GenesisColors.emerald.withValues(alpha: .8)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1;

    canvas.save();
    canvas.translate(center.dx, center.dy);
    canvas.rotate(-.45);
    canvas.drawOval(
      Rect.fromCenter(
        center: Offset.zero,
        width: radius * 1.5,
        height: radius * .72,
      ),
      orbitPaint,
    );
    canvas.restore();

    canvas.drawCircle(
      Offset(center.dx + radius * .54, center.dy - radius * .25),
      2.8,
      Paint()..color = GenesisColors.emerald,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

