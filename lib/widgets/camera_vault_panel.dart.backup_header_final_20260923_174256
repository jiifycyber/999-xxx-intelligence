class _CameraVaultPanelState extends State<CameraVaultPanel> {
  static const String _apiBase =
      'https://jontariuss-macbook-pro.tail49e2f2.ts.net:8791';

  bool _loading = true;
  String? _error;
  int _selectedTab = 0;

  List<_Recording> _recordings = [];
  int _retentionHours = 72;
  int _recordingCount = 0;
  int _playableCount = 0;
  int _usedBytes = 0;

  @override
  void initState() {
    super.initState();
    _refresh();
  }

  Future<void> _refresh() async {
    if (mounted) {
      setState(() {
        _loading = true;
        _error = null;
      });
    }

    try {
      final response = await http
          .get(Uri.parse('$_apiBase/recordings'))
          .timeout(const Duration(seconds: 10));

      if (response.statusCode != 200) {
        throw Exception('HTTP ${response.statusCode}');
      }

      final json = jsonDecode(response.body) as Map<String, dynamic>;
      final rows = (json['recordings'] as List<dynamic>? ?? const []);

      final recordings = rows
          .map(
            (row) => _Recording.fromJson(
              row as Map<String, dynamic>,
            ),
          )
          .toList();

      if (!mounted) return;

      setState(() {
        _recordings = recordings;
        _retentionHours = (json['retention_hours'] as num?)?.toInt() ?? 72;
        _recordingCount = (json['recording_count'] as num?)?.toInt() ?? 0;
        _playableCount = (json['playable_count'] as num?)?.toInt() ?? 0;
        _usedBytes = (json['used_bytes'] as num?)?.toInt() ?? 0;
        _loading = false;
      });
    } catch (e) {
      if (!mounted) return;

      setState(() {
        _error = e.toString();
        _loading = false;
      });
    }
  }

  Future<void> _play(_Recording recording) async {
    if (!recording.finalized) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content:
              Text('This clip is still recording and is not finalized yet.'),
        ),
      );
      return;
    }

    await showDialog<void>(
      context: context,
      barrierColor: Colors.black87,
      builder: (_) => _VaultPlaybackDialog(
        recording: recording,
        url: '$_apiBase${recording.playUrl}',
      ),
    );
  }

  void _jumpTo(Duration ago) {
    final target = DateTime.now().subtract(ago);

    final playable = _recordings.where((r) => r.finalized).toList();

    if (playable.isEmpty) {
      _nothingFound();
      return;
    }

    playable.sort((a, b) {
      final aDelta = a.startedAt.difference(target).abs();
      final bDelta = b.startedAt.difference(target).abs();
      return aDelta.compareTo(bDelta);
    });

    _play(playable.first);
  }

  void _jumpYesterday() {
    final now = DateTime.now();
    final target = now.subtract(const Duration(days: 1));

    final matches = _recordings.where((r) {
      return r.finalized &&
          r.startedAt.year == target.year &&
          r.startedAt.month == target.month &&
          r.startedAt.day == target.day;
    }).toList();

    if (matches.isEmpty) {
      _nothingFound(
          message: 'No finalized recording is available from yesterday yet.');
      return;
    }

    _play(matches.first);
  }

  void _nothingFound({
    String message = 'No finalized recording is available for that time.',
  }) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message)),
    );
  }

