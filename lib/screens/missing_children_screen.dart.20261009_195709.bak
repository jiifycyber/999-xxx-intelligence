import '../services/ic391_case_store.dart';
import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:url_launcher/url_launcher.dart';

class MissingChildrenScreen extends StatefulWidget {
  const MissingChildrenScreen({super.key});

  @override
  State<MissingChildrenScreen> createState() => _MissingChildrenScreenState();
}

class _MissingChildrenScreenState extends State<MissingChildrenScreen> {
  final TextEditingController searchController = TextEditingController();

  List<Map<String, dynamic>> records = [];
  bool loading = true;
  String? error;
  String query = '';
  String selectedSource = 'ALL';
  String selectedCategory = 'ALL INTELLIGENCE';
  String selectedState = 'ALL';

  static const intelligenceCategories = [
    'ALL INTELLIGENCE',
    'MISSING CHILDREN',
    'HUMAN TRAFFICKING',
    'MISSING PERSONS',
    'WANTED PERSONS',
    'INTERNATIONAL INTELLIGENCE',
    'FEDERAL INVESTIGATIONS',
    'ACTIVE ALERTS',
    'REVIEW REQUIRED',
  ];

  Set<String> classifyRecord(Map<String, dynamic> record) {
    final categories = record['intelligence_categories'];
    if (categories is List) {
      return categories.map((e) => e.toString()).toSet();
    }
    return {'REVIEW REQUIRED'};
  }

  @override
  void initState() {
    super.initState();
    loadRecords();
  }

  Future<void> loadRecords() async {
    try {
      final content = await rootBundle.loadString(
        'data/intelligence/dashboard/unified_enriched_records.json',
      );

      final decoded = jsonDecode(content) as Map<String, dynamic>;
      final items = decoded['records'] as List<dynamic>;

      if (!mounted) return;

      setState(() {
        records = items
            .whereType<Map>()
            .map((item) => Map<String, dynamic>.from(item))
            .toList();
        loading = false;
        error = null;
      });
    } catch (e) {
      if (!mounted) return;
      setState(() {
        error = e.toString();
        loading = false;
      });
    }
  }

  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }

  String display(dynamic value) {
    if (value == null) return 'Not provided';
    if (value is List) return value.join(', ');
    final result = value.toString().trim();
    return result.isEmpty ? 'Not provided' : result;
  }

  Future<void> openSource(Map<String, dynamic> record) async {
    final raw = record['source_url']?.toString() ?? '';
    final parsed = Uri.tryParse(raw);
    if (parsed == null) return;

    final host = parsed.host.toLowerCase();
    final trusted = host == 'fbi.gov' ||
        host.endsWith('.fbi.gov') ||
        host == 'missingkids.org' ||
        host.endsWith('.missingkids.org');

    if (!trusted) return;
    if (parsed.scheme != 'http' && parsed.scheme != 'https') return;

    final uri = parsed.replace(scheme: 'https');
    await launchUrl(uri, mode: LaunchMode.externalApplication);
  }

  Widget intelligenceField(String label, dynamic value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            label.toUpperCase(),
            style: const TextStyle(
              color: Colors.tealAccent,
              fontSize: 11,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 5),
          SelectableText(display(value)),
        ],
      ),
    );
  }

  Widget sourcePhoto(Map<String, dynamic> record) {
    final details = record['source_details'];
    if (details is! Map) return const SizedBox.shrink();

    final images = details['images'];
    if (images is! List || images.isEmpty) {
      return const SizedBox.shrink();
    }

    final urls = <String>[];

    for (final image in images) {
      if (image is Map) {
        final url =
            (image['original'] ?? image['large'] ?? image['thumb'])?.toString();

        if (url != null && Uri.tryParse(url)?.scheme == 'https') {
          urls.add(url);
        }
      }
    }

    if (urls.isEmpty) return const SizedBox.shrink();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'OFFICIAL SOURCE IMAGES',
          style: TextStyle(
            color: Colors.tealAccent,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 10),
        SizedBox(
          height: 190,
          child: ListView.separated(
            scrollDirection: Axis.horizontal,
            itemCount: urls.length,
            separatorBuilder: (_, __) => const SizedBox(width: 10),
            itemBuilder: (context, index) {
              return ClipRRect(
                borderRadius: BorderRadius.circular(10),
                child: Image.network(
                  urls[index],
                  webHtmlElementStrategy: WebHtmlElementStrategy.prefer,
                  width: 170,
                  fit: BoxFit.cover,
                  errorBuilder: (_, __, ___) => const SizedBox(
                    width: 170,
                    child: Center(
                      child: Icon(Icons.image_not_supported_outlined),
                    ),
                  ),
                ),
              );
            },
          ),
        ),
        const SizedBox(height: 20),
      ],
    );
  }

  Widget fullSourceFields(Map<String, dynamic> record) {
    final raw = record['source_details'];

    if (raw is! Map || raw.isEmpty) {
      return const Text('Full source details not available.');
    }

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'COMPLETE ORIGINAL SOURCE DATA',
          style: TextStyle(
            color: Colors.tealAccent,
            fontWeight: FontWeight.bold,
          ),
        ),
        const Divider(),
        for (final entry in raw.entries)
          intelligenceField(
            entry.key.toString(),
            entry.value is Map || entry.value is List
                ? const JsonEncoder.withIndent('  ').convert(entry.value)
                : entry.value,
          ),
      ],
    );
  }

  Future<void> openForReview(Map<String, dynamic> record) async {
    try {
      await Ic391CaseStore.add(record);
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Added to Active Cases for private review'),
        ),
      );
    } catch (error) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Could not open case: $error')),
      );
    }
  }

  void showDetails(Map<String, dynamic> record) {
    final categories = classifyRecord(record).toList()..sort();

    final fields = <String, dynamic>{
      'Source agency': record['source_id'],
      'Source record ID': record['source_record_id'],
      'Global record ID': record['global_id'],
      'Record type': record['record_type'],
      'State / location': record['state'],
      'Subjects': record['subjects'],
      'Published date': record['published'],
      'Case status': record['case_status'],
      'Cross-source matching': record['cross_source_match'],
      'Review required': record['review_required'],
    };

    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      backgroundColor: const Color(0xFF101C32),
      builder: (context) => SafeArea(
        child: FractionallySizedBox(
          heightFactor: 0.92,
          child: Column(
            children: [
              Container(
                padding: const EdgeInsets.all(16),
                decoration: const BoxDecoration(
                  color: Color(0xFF172A48),
                ),
                child: Row(
                  children: [
                    const Icon(
                      Icons.folder_shared_outlined,
                      color: Colors.tealAccent,
                      size: 32,
                    ),
                    const SizedBox(width: 12),
                    const Expanded(
                      child: Text(
                        'IC391DEA | INTELLIGENCE CASE FILE',
                        style: TextStyle(
                          color: Colors.white,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                    IconButton(
                      onPressed: () => Navigator.pop(context),
                      icon: const Icon(
                        Icons.close,
                        color: Colors.white,
                      ),
                    ),
                  ],
                ),
              ),
              Expanded(
                child: ListView(
                  padding: const EdgeInsets.all(18),
                  children: [
                    Text(
                      display(record['title']),
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 22,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 10),
                    const Text(
                      'PUBLIC INTELLIGENCE RECORD - NOT VERIFIED',
                      style: TextStyle(
                        color: Colors.amberAccent,
                        fontWeight: FontWeight.bold,
                        fontSize: 11,
                      ),
                    ),
                    const SizedBox(height: 16),
                    Wrap(
                      spacing: 7,
                      runSpacing: 7,
                      children: categories.map((category) {
                        return Chip(
                          label: Text(category),
                          backgroundColor: const Color(0xFF203A59),
                          labelStyle: const TextStyle(
                            color: Colors.white,
                            fontSize: 10,
                          ),
                        );
                      }).toList(),
                    ),
                    Padding(
                      padding: const EdgeInsets.only(bottom: 16),
                      child: FilledButton.icon(
                        onPressed: () => openForReview(record),
                        icon: const Icon(Icons.folder_open),
                        label: const Text('OPEN IN ACTIVE CASES'),
                      ),
                    ),
                    sourcePhoto(record),
                    const SizedBox(height: 22),
                    const Text(
                      'CASE IDENTIFICATION',
                      style: TextStyle(
                        color: Colors.tealAccent,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const Divider(),
                    for (final entry in fields.entries)
                      intelligenceField(entry.key, entry.value),
                    const SizedBox(height: 12),
                    const Text(
                      'OFFICIAL SOURCE DESCRIPTION',
                      style: TextStyle(
                        color: Colors.tealAccent,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const Divider(),
                    SelectableText(
                      display(record['description']),
                      style: const TextStyle(height: 1.5),
                    ),
                    const SizedBox(height: 22),
                    fullSourceFields(record),
                    const SizedBox(height: 22),
                    const Text(
                      'CROSS-SOURCE INTELLIGENCE',
                      style: TextStyle(
                        color: Colors.tealAccent,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const Divider(),
                    const Text(
                      'Potential related records have not been '
                      'evaluated. No confirmed connection is implied.',
                    ),
                    const SizedBox(height: 22),
                    const Text(
                      'PRIVATE INVESTIGATION VAULT',
                      style: TextStyle(
                        color: Colors.tealAccent,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const Divider(),
                    const Text(
                      'Private notes and evidence management '
                      'will be connected in a future phase. '
                      'No automatic evidence sharing is enabled.',
                    ),
                    const SizedBox(height: 24),
                    FilledButton.icon(
                      onPressed: () => openSource(record),
                      icon: const Icon(Icons.open_in_new),
                      label: const Text('OPEN OFFICIAL SOURCE'),
                    ),
                    const SizedBox(height: 16),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    if (loading) {
      return const Center(child: CircularProgressIndicator());
    }

    if (error != null) {
      return Center(
        child: SelectableText('DATABASE ERROR: $error'),
      );
    }

    final sources = records
        .map((r) => display(r['source_id']).toUpperCase())
        .toSet()
        .toList()
      ..sort();

    final states = records
        .map((r) => display(r['state']).toUpperCase())
        .where((s) => RegExp(r'^[A-Z]{2}$').hasMatch(s))
        .toSet()
        .toList()
      ..sort();

    final search = query.trim().toLowerCase();

    final results = records.where((record) {
      final source = display(record['source_id']).toUpperCase();
      final state = display(record['state']).toUpperCase();

      if (selectedCategory != 'ALL INTELLIGENCE' &&
          !classifyRecord(record).contains(selectedCategory)) {
        return false;
      }

      if (selectedSource != 'ALL' && source != selectedSource) {
        return false;
      }

      if (selectedState != 'ALL' && state != selectedState) {
        return false;
      }

      if (search.isEmpty) return true;

      final searchable = [
        record['title'],
        record['description'],
        record['state'],
        record['subjects'],
        record['source_record_id'],
        record['source_id'],
      ].map(display).join(' ').toLowerCase();

      return searchable.contains(search);
    }).toList();

    return Column(
      children: [
        Padding(
          padding: const EdgeInsets.all(12),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'IC391DEA | MISSING CHILDREN INTELLIGENCE',
                style: TextStyle(
                  color: Colors.tealAccent,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              Text('${records.length} unified source records'),
              const SizedBox(height: 5),
              const Text(
                'One intelligence database. Records are not '
                'verified unique missing-child cases. '
                'Snapshot only; no live synchronization.',
                style: TextStyle(fontSize: 11),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: searchController,
                onChanged: (value) {
                  setState(() => query = value);
                },
                decoration: const InputDecoration(
                  hintText: 'Search all intelligence records',
                  prefixIcon: Icon(Icons.search),
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 10),
              Row(
                children: [
                  Expanded(
                    child: DropdownButtonFormField<String>(
                      initialValue: selectedSource,
                      isExpanded: true,
                      decoration: const InputDecoration(
                        labelText: 'SOURCE',
                        border: OutlineInputBorder(),
                      ),
                      items: [
                        'ALL',
                        ...sources,
                      ].map((item) {
                        return DropdownMenuItem<String>(
                          value: item,
                          child: Text(
                            item == 'ALL' ? 'ALL SOURCES' : item,
                            overflow: TextOverflow.ellipsis,
                          ),
                        );
                      }).toList(),
                      onChanged: (value) {
                        if (value != null) {
                          setState(() => selectedSource = value);
                        }
                      },
                    ),
                  ),
                  const SizedBox(width: 8),
                  Expanded(
                    child: DropdownButtonFormField<String>(
                      initialValue: selectedState,
                      isExpanded: true,
                      decoration: const InputDecoration(
                        labelText: 'STATE',
                        border: OutlineInputBorder(),
                      ),
                      items: [
                        'ALL',
                        ...states,
                      ].map((item) {
                        return DropdownMenuItem<String>(
                          value: item,
                          child: Text(
                            item == 'ALL' ? 'ALL STATES' : item,
                            overflow: TextOverflow.ellipsis,
                          ),
                        );
                      }).toList(),
                      onChanged: (value) {
                        if (value != null) {
                          setState(() => selectedState = value);
                        }
                      },
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              const SizedBox(height: 10),
              DropdownButtonFormField<String>(
                initialValue: selectedCategory,
                isExpanded: true,
                decoration: const InputDecoration(
                  labelText: 'INTELLIGENCE CATEGORY',
                  border: OutlineInputBorder(),
                  prefixIcon: Icon(Icons.category_outlined),
                ),
                items: intelligenceCategories.map((category) {
                  return DropdownMenuItem<String>(
                    value: category,
                    child: Text(
                      category,
                      overflow: TextOverflow.ellipsis,
                    ),
                  );
                }).toList(),
                onChanged: (value) {
                  if (value != null) {
                    setState(() => selectedCategory = value);
                  }
                },
              ),
              const SizedBox(height: 10),
              const Text(
                'Categories are preliminary automated classifications. '
                'Verify case details against the original source.',
                style: TextStyle(fontSize: 11),
              ),
              Text('${results.length} matching source records'),
            ],
          ),
        ),
        Expanded(
          child: ListView.builder(
            itemCount: results.length,
            itemBuilder: (context, index) {
              final record = results[index];
              final agency = display(record['source_id']).toUpperCase();

              return Card(
                margin: const EdgeInsets.symmetric(
                  horizontal: 12,
                  vertical: 5,
                ),
                child: ListTile(
                  leading: Icon(
                    agency == 'NCMEC'
                        ? Icons.child_care_outlined
                        : Icons.folder_shared_outlined,
                    color: Colors.tealAccent,
                  ),
                  title: Text(display(record['title'])),
                  subtitle: Text(
                    '$agency | ${display(record['state'])}\n'
                    'REVIEW REQUIRED',
                    maxLines: 2,
                  ),
                  isThreeLine: true,
                  trailing: const Icon(Icons.chevron_right),
                  onTap: () => showDetails(record),
                ),
              );
            },
          ),
        ),
      ],
    );
  }
}
