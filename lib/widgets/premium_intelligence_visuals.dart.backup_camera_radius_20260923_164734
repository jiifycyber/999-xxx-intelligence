class _SecurityFeedPainter extends CustomPainter {
  const _SecurityFeedPainter(this.index);

  final int index;

  @override
  void paint(Canvas canvas, Size size) {
    canvas.drawRect(
      Offset.zero & size,
      Paint()
        ..shader = const LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            Color(0xFF21384A),
            Color(0xFF0B1924),
            Color(0xFF02070B),
          ],
        ).createShader(Offset.zero & size),
    );

    final structure = Paint()
      ..color = const Color(0xFF638091).withValues(alpha: .46)
      ..style = PaintingStyle.stroke
      ..strokeWidth = .8;

    final floorY = size.height * .76;
    canvas.drawLine(Offset(0, floorY), Offset(size.width, floorY), structure);

    if (index == 0) {
      canvas.drawRect(
        Rect.fromLTWH(
          size.width * .28,
          size.height * .18,
          size.width * .45,
          size.height * .58,
        ),
        structure,
      );
      canvas.drawLine(
        Offset(size.width * .50, size.height * .18),
        Offset(size.width * .50, floorY),
        structure,
      );
    } else if (index == 1) {
      for (var x = .12; x < .9; x += .25) {
        canvas.drawRect(
          Rect.fromLTWH(
            size.width * x,
            size.height * .16,
            size.width * .17,
            size.height * .60,
          ),
          structure,
        );
      }
    } else if (index == 2) {
      canvas.drawLine(
        Offset(size.width * .08, floorY),
        Offset(size.width * .42, size.height * .28),
        structure,
      );
      canvas.drawLine(
        Offset(size.width * .92, floorY),
        Offset(size.width * .58, size.height * .28),
        structure,
      );
      canvas.drawLine(
        Offset(size.width * .42, size.height * .28),
        Offset(size.width * .58, size.height * .28),
        structure,
      );
    } else {
      canvas.drawLine(
        Offset(size.width * .12, floorY),
        Offset(size.width * .12, size.height * .20),
        structure,
      );
      canvas.drawLine(
        Offset(size.width * .12, size.height * .20),
        Offset(size.width * .86, size.height * .20),
        structure,
      );
      canvas.drawLine(
        Offset(size.width * .86, size.height * .20),
        Offset(size.width * .86, floorY),
        structure,
      );
    }

    final scan = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .12)
      ..strokeWidth = .5;

    for (double y = 3; y < size.height; y += 4) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), scan);
    }

    canvas.drawCircle(
      const Offset(7, 7),
      2.2,
      Paint()..color = GenesisColors.danger,
    );

    final timestamp = TextPainter(
      text: TextSpan(
        text: 'CAM 0${index + 1}',
        style: const TextStyle(
          color: Color(0xFFB7D5E5),
          fontSize: 5,
        ),
      ),
      textDirection: TextDirection.ltr,
    )..layout();

    timestamp.paint(canvas, Offset(size.width - timestamp.width - 4, 4));
  }

  @override
  bool shouldRepaint(covariant _SecurityFeedPainter oldDelegate) =>
      oldDelegate.index != index;
}
