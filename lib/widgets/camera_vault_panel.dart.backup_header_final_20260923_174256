  String _formatBytes(int bytes) {
    if (bytes >= 1024 * 1024 * 1024) {
      return '${(bytes / (1024 * 1024 * 1024)).toStringAsFixed(1)} GB';
    }

    if (bytes >= 1024 * 1024) {
      return '${(bytes / (1024 * 1024)).toStringAsFixed(0)} MB';
    }

    return '${(bytes / 1024).toStringAsFixed(0)} KB';
  }

  String _formatDuration(double? seconds) {
    if (seconds == null) return '--';

    final total = seconds.round();
    final minutes = total ~/ 60;
    final secs = total % 60;

    return '${minutes}m ${secs.toString().padLeft(2, '0')}s';
  }

  String _formatDateTime(DateTime date) {
    final hour = date.hour == 0
        ? 12
        : date.hour > 12
            ? date.hour - 12
            : date.hour;

    final minute = date.minute.toString().padLeft(2, '0');
    final second = date.second.toString().padLeft(2, '0');
    final period = date.hour >= 12 ? 'PM' : 'AM';

    return '${date.month}/${date.day}/${date.year}  $hour:$minute:$second $period';
  }
}

class _Recording {
  const _Recording({
    required this.name,
    required this.startedAt,
    required this.sizeBytes,
    required this.durationSeconds,
    required this.finalized,
    required this.playUrl,
  });

  final String name;
  final DateTime startedAt;
  final int sizeBytes;
  final double? durationSeconds;
  final bool finalized;
  final String playUrl;

  factory _Recording.fromJson(Map<String, dynamic> json) {
    return _Recording(
      name: json['name'] as String? ?? 'recording.mp4',
      startedAt: DateTime.tryParse(
            json['started_at'] as String? ?? '',
          ) ??
          DateTime.now(),
      sizeBytes: (json['size_bytes'] as num?)?.toInt() ?? 0,
      durationSeconds: (json['duration_seconds'] as num?)?.toDouble(),
      finalized: json['finalized'] == true,
      playUrl: json['play_url'] as String? ?? '',
    );
  }
}

