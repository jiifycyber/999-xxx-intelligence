class _BiometricPainter extends CustomPainter {
  const _BiometricPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final cyan = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .98)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.25;

    final bright = Paint()
      ..color = const Color(0xFF7EF9FF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 1.7;

    final mesh = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .42)
      ..style = PaintingStyle.stroke
      ..strokeWidth = .65;

    final faint = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .18)
      ..style = PaintingStyle.stroke
      ..strokeWidth = .5;

    final glow = Paint()
      ..color = GenesisColors.cyan.withValues(alpha: .10)
      ..style = PaintingStyle.fill;

    final scanGlow = Paint()
      ..color = GenesisColors.emerald.withValues(alpha: .16)
      ..style = PaintingStyle.fill;

    final scan = Paint()
      ..color = GenesisColors.emerald.withValues(alpha: .98)
      ..strokeWidth = 1.8;

    final centerX = size.width * .5;

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(2, 2, size.width - 4, size.height - 4),
        const Radius.circular(5),
      ),
      faint,
    );

    for (double x = 10; x < size.width; x += 12) {
      canvas.drawLine(
        Offset(x, 5),
        Offset(x, size.height - 5),
        Paint()
          ..color = GenesisColors.cyan.withValues(alpha: .055)
          ..strokeWidth = .4,
      );
    }

    for (double y = 8; y < size.height; y += 10) {
      canvas.drawLine(
        Offset(5, y),
        Offset(size.width - 5, y),
        Paint()
          ..color = GenesisColors.cyan.withValues(alpha: .055)
          ..strokeWidth = .4,
      );
    }

    canvas.drawOval(
      Rect.fromCenter(
        center: Offset(centerX, size.height * .43),
        width: size.width * .68,
        height: size.height * .76,
      ),
      glow,
    );

    final head = Path()
      ..moveTo(size.width * .31, size.height * .18)
      ..quadraticBezierTo(
        size.width * .50,
        size.height * .025,
        size.width * .69,
        size.height * .18,
      )
      ..quadraticBezierTo(
        size.width * .76,
        size.height * .34,
        size.width * .70,
        size.height * .58,
      )
      ..quadraticBezierTo(
        size.width * .65,
        size.height * .76,
        size.width * .50,
        size.height * .82,
      )
      ..quadraticBezierTo(
        size.width * .35,
        size.height * .76,
        size.width * .30,
        size.height * .58,
      )
      ..quadraticBezierTo(
        size.width * .24,
        size.height * .34,
        size.width * .31,
        size.height * .18,
      )
      ..close();

    canvas.drawPath(head, bright);

    final leftEar = Path()
      ..moveTo(size.width * .29, size.height * .34)
      ..quadraticBezierTo(
        size.width * .19,
        size.height * .36,
        size.width * .27,
        size.height * .54,
      );

    final rightEar = Path()
      ..moveTo(size.width * .71, size.height * .34)
      ..quadraticBezierTo(
        size.width * .81,
        size.height * .36,
        size.width * .73,
        size.height * .54,
      );

    canvas.drawPath(leftEar, cyan);
    canvas.drawPath(rightEar, cyan);

    final neckAndShoulders = Path()
      ..moveTo(size.width * .40, size.height * .76)
      ..lineTo(size.width * .39, size.height * .88)
      ..quadraticBezierTo(
        size.width * .17,
        size.height * .91,
        size.width * .10,
        size.height,
      )
      ..moveTo(size.width * .60, size.height * .76)
      ..lineTo(size.width * .61, size.height * .88)
      ..quadraticBezierTo(
        size.width * .83,
        size.height * .91,
        size.width * .90,
        size.height,
      );

    canvas.drawPath(neckAndShoulders, cyan);

    for (final y in [.25, .33, .42, .51, .60, .68]) {
      final halfWidth = y < .33
          ? size.width * .12
          : y < .60
              ? size.width * .20
              : size.width * .15;

      canvas.drawLine(
        Offset(centerX - halfWidth, size.height * y),
        Offset(centerX + halfWidth, size.height * y),
        mesh,
      );
    }

    final leftMesh = Path()
      ..moveTo(centerX, size.height * .08)
      ..quadraticBezierTo(
        size.width * .35,
        size.height * .33,
        size.width * .33,
        size.height * .58,
      )
      ..quadraticBezierTo(
        size.width * .37,
        size.height * .73,
        centerX,
        size.height * .81,
      );

    final rightMesh = Path()
      ..moveTo(centerX, size.height * .08)
      ..quadraticBezierTo(
        size.width * .65,
        size.height * .33,
        size.width * .67,
        size.height * .58,
      )
      ..quadraticBezierTo(
        size.width * .63,
        size.height * .73,
        centerX,
        size.height * .81,
      );

    canvas.drawPath(leftMesh, mesh);
    canvas.drawPath(rightMesh, mesh);

    canvas.drawLine(
      Offset(centerX, size.height * .08),
      Offset(centerX, size.height * .79),
      mesh,
    );

    final leftEye = Path()
      ..moveTo(size.width * .35, size.height * .39)
      ..quadraticBezierTo(
        size.width * .41,
        size.height * .35,
        size.width * .47,
        size.height * .40,
      )
      ..quadraticBezierTo(
        size.width * .41,
        size.height * .44,
        size.width * .35,
        size.height * .39,
      );

    final rightEye = Path()
      ..moveTo(size.width * .53, size.height * .40)
      ..quadraticBezierTo(
        size.width * .59,
        size.height * .35,
        size.width * .65,
        size.height * .39,
      )
      ..quadraticBezierTo(
        size.width * .59,
        size.height * .44,
        size.width * .53,
        size.height * .40,
      );

    canvas.drawPath(leftEye, bright);
    canvas.drawPath(rightEye, bright);

    canvas.drawCircle(
      Offset(size.width * .41, size.height * .395),
      2.5,
      Paint()..color = GenesisColors.emerald,
    );

    canvas.drawCircle(
      Offset(size.width * .59, size.height * .395),
      2.5,
      Paint()..color = GenesisColors.emerald,
    );

    final nose = Path()
      ..moveTo(centerX, size.height * .42)
      ..lineTo(size.width * .46, size.height * .58)
      ..quadraticBezierTo(
        centerX,
        size.height * .61,
        size.width * .54,
        size.height * .58,
      );

    canvas.drawPath(nose, bright);

    final mouth = Path()
      ..moveTo(size.width * .39, size.height * .67)
      ..quadraticBezierTo(
        centerX,
        size.height * .63,
        size.width * .61,
        size.height * .67,
      )
      ..quadraticBezierTo(
        centerX,
        size.height * .73,
        size.width * .39,
        size.height * .67,
      );

    canvas.drawPath(mouth, bright);

    final landmarks = <Offset>[
      Offset(.31 * size.width, .18 * size.height),
      Offset(.69 * size.width, .18 * size.height),
      Offset(.35 * size.width, .39 * size.height),
      Offset(.47 * size.width, .40 * size.height),
      Offset(.53 * size.width, .40 * size.height),
      Offset(.65 * size.width, .39 * size.height),
      Offset(.50 * size.width, .48 * size.height),
      Offset(.46 * size.width, .58 * size.height),
      Offset(.54 * size.width, .58 * size.height),
      Offset(.39 * size.width, .67 * size.height),
      Offset(.50 * size.width, .70 * size.height),
      Offset(.61 * size.width, .67 * size.height),
      Offset(.35 * size.width, .72 * size.height),
      Offset(.65 * size.width, .72 * size.height),
      Offset(.50 * size.width, .81 * size.height),
    ];

    for (final point in landmarks) {
      canvas.drawCircle(
        point,
        1.55,
        Paint()..color = const Color(0xFF8FFFFF),
      );
    }

    canvas.drawRect(
      Rect.fromLTWH(
        size.width * .16,
        size.height * .475,
        size.width * .68,
        size.height * .055,
      ),
      scanGlow,
    );

    canvas.drawLine(
      Offset(size.width * .14, size.height * .505),
      Offset(size.width * .86, size.height * .505),
      scan,
    );

    final brackets = Path()
      ..moveTo(size.width * .12, size.height * .20)
      ..lineTo(size.width * .12, size.height * .11)
      ..lineTo(size.width * .23, size.height * .11)
      ..moveTo(size.width * .77, size.height * .11)
      ..lineTo(size.width * .88, size.height * .11)
      ..lineTo(size.width * .88, size.height * .20)
      ..moveTo(size.width * .12, size.height * .78)
      ..lineTo(size.width * .12, size.height * .87)
      ..lineTo(size.width * .23, size.height * .87)
      ..moveTo(size.width * .77, size.height * .87)
      ..lineTo(size.width * .88, size.height * .87)
      ..lineTo(size.width * .88, size.height * .78);

    canvas.drawPath(brackets, bright);

    canvas.drawCircle(
      Offset(size.width * .12, size.height * .49),
      2.4,
      Paint()..color = GenesisColors.emerald,
    );

    canvas.drawCircle(
      Offset(size.width * .88, size.height * .49),
      2.4,
      Paint()..color = GenesisColors.emerald,
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

